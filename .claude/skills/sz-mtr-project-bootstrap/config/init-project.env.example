# SZ-MTR project bootstrap input.
# Copy this file to a private location before use, for example:
#   ~/.config/sz-mtr-project-bootstrap/<app>.init.env
#
# Never commit the filled file. It may contain GitLab tokens and deployment details.

# Project identity
INIT_TARGET_DIR=/path/to/local/project
APP_SLUG=contract-review
DISPLAY_NAME=合同审查系统
APP_DOMAIN=contract-review.agent-test.sz-mtr.com
BACKEND=fastapi
FRONTEND=vite-react
DATABASE=mysql
BACKEND_PORT=18080
ENABLE_OIDC=false

# GitLab project
GITLAB_URL=http://aico-test.sz-mtr.com
GITLAB_GROUP=xujiqiu
GITLAB_PROJECT=contract-review
GITLAB_PROJECT_PATH=xujiqiu/contract-review
GITLAB_ACCESS_TOKEN=__FILL_IN_PRIVATE_TOKEN__
GIT_REMOTE_NAME=origin
MAIN_BRANCH=main

# Docker Registry. Use the GitLab co-located registry when available.
REGISTRY_URL=aico-test.sz-mtr.com:5050
REGISTRY_NAMESPACE=xujiqiu
REGISTRY_IMAGE=aico-test.sz-mtr.com:5050/xujiqiu/contract-review
REGISTRY_INSECURE=true

# Runner tags. These must match registered GitLab Runner tags.
BUILD_RUNNER_TAG=contract-review-build
TEST_RUNNER_TAG=contract-review-test
PROD_RUNNER_TAG=contract-review-prod

# Test deployment. The test runner runs on this host and deploys locally.
TEST_ENVIRONMENT_NAME=test
TEST_BASE_URL=http://contract-review.agent-test.sz-mtr.com
TEST_DEPLOY_DIR=/data/contract-review/deploy
TEST_HOST_PORT=18080
TEST_HEALTH_URL=http://127.0.0.1:18080/api/health

# Production deployment. Production must use manual/protected tag approval.
PROD_ENVIRONMENT_NAME=production
PROD_BASE_URL=https://contract-review.agent.sz-mtr.com
PROD_DEPLOY_DIR=/data/contract-review/deploy
PROD_HOST_PORT=18080
PROD_HEALTH_URL=http://127.0.0.1:18080/api/health
PROD_RELEASE_TRIGGER=manual-protected-tag

# Bootstrap behavior
CREATE_GITLAB_PROJECT=true
PUSH_MAIN=true
WAIT_FOR_TEST_PIPELINE=true
OPEN_TEST_URL_AFTER_DEPLOY=true
